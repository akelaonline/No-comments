<?xml version="1.0"?>
<ruleset name="NO Comments">
  <description>WordPress security and internationalization checks for NO Comments.</description>

  <file>no-comments/</file>

  <arg name="extensions" value="php" />
  <arg name="basepath" value="." />
  <arg value="sp" />

  <exclude-pattern>no-comments/languages/*</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>

  <!-- The project keeps its established formatting; CI focuses on correctness. -->
  <rule ref="WordPress.Security">
    <!-- Read-only query parameters only render admin state and do not mutate data. -->
    <exclude name="WordPress.Security.NonceVerification.Recommended" />
  </rule>
  <rule ref="WordPress.WP.I18n" />

  <config name="minimum_supported_wp_version" value="6.0" />
</ruleset>
