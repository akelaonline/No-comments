<?xml version="1.0"?>
<ruleset name="NO Comments">
  <description>WordPress Coding Standards for NO Comments.</description>

  <file>no-comments/</file>

  <arg name="extensions" value="php" />
  <arg name="basepath" value="." />
  <arg value="sp" />

  <exclude-pattern>no-comments/languages/*</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>

  <rule ref="WordPress">
    <!-- The plugin uses PSR-4-style namespaced class files. -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
  </rule>

  <config name="minimum_supported_wp_version" value="5.9" />
</ruleset>
