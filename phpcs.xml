<?xml version="1.0"?>
<ruleset name="NO Comments">
  <description>WordPress Coding Standards + PSR-12 para el plugin NO Comments.</description>

  <!-- Rutas a analizar -->
  <file>no-comments/</file>

  <!-- Exclusiones -->
  <exclude-pattern>no-comments/languages/*</exclude-pattern>
  <exclude-pattern>no-comments/*.zip</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>.github/*</exclude-pattern>

  <!-- Estándares -->
  <rule ref="PSR12" />
  <rule ref="WordPress-Extra">
    <!-- Ejemplo de exclusión puntual si fuera necesario
    <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase" />
    -->
  </rule>

  <!-- Configuración WPCS -->
  <config name="minimum_supported_wp_version" value="5.9" />
</ruleset>
