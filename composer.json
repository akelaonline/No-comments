{
  "name": "akelaonline/no-comments",
  "description": "NO Comments — disable comments and safely clean them up in WordPress.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Alejandro D. José",
      "homepage": "https://github.com/akelaonline"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "scripts": {
    "lint": "phpcs -q",
    "lint:report": "phpcs --report=full",
    "fix": "phpcbf || true"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "support": {
    "issues": "https://github.com/akelaonline/No-comments/issues",
    "source": "https://github.com/akelaonline/No-comments"
  }
}
